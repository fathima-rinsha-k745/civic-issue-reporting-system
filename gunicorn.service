[Unit]
Description=Gunicorn daemon for Civic Issue Tracker (Django)
After=network.target

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/miniProject/backend
ExecStart=/home/ubuntu/miniProject/backend/venv/bin/gunicorn \
          --workers 3 \
          --bind 127.0.0.1:8000 \
          --access-logfile /var/log/gunicorn/access.log \
          --error-logfile /var/log/gunicorn/error.log \
          config.wsgi:application
EnvironmentFile=/home/ubuntu/miniProject/backend/.env
Restart=on-failure

[Install]
WantedBy=multi-user.target
